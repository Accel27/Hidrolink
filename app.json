{
  "expo": {
    "name": "Hidrolink",
    "slug": "hidrolink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hidrolink",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0EA5E9"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0EA5E9"
      },
      "package": "com.anonymous.hidrolink"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
